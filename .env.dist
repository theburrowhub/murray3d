# Plantilla de configuración de murray3d.
# Copia este fichero a .env y rellena tu clave:
#   cp .env.dist .env
# .env está en .gitignore y NO se sube al repositorio.

# API key de 3DBundle (obligatoria). También puede pasarse por la variable de
# entorno MURRAY_API_KEY.
MURRAY_API_KEY=

# Opcional: sobreescribir la URL base de la API.
# MURRAY_BASE_URL=https://murrayslab.com/3dbundle/api
